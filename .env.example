# Copy to .env and fill in. .env is never committed.

# Postgres with pleb-api's schema. Inside pleb-api's compose this is set for you.
DATABASE_URL=postgresql://pleb:pleb@localhost:5432/pleb

# Nebius Token Factory (OpenAI-compatible). Needed for any run that calls a model, dry runs included.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=

# Models. Check the Token Factory model list for current IDs; the vision model must accept images.
PLEB_TEXT_MODEL=meta-llama/Llama-3.3-70B-Instruct
PLEB_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# "tool" (tool calling) or "prompted" (JSON in the prompt) for models without tool support.
PLEB_OUTPUT_MODE=tool

# USD per million tokens, for the --max-spend-usd estimate. Set them from the Token Factory price list.
PLEB_TEXT_PRICE_IN=1.0
PLEB_TEXT_PRICE_OUT=3.0
PLEB_VISION_PRICE_IN=1.0
PLEB_VISION_PRICE_OUT=3.0

# Public page describing the crawler and how to opt out; sent in the User-Agent.
PLEB_CRAWLER_CONTACT=https://github.com/yocca/pleb-agent/blob/main/docs/crawling.md
# Minimum seconds between requests to one host (robots.txt Crawl-delay can raise it).
PLEB_MIN_DELAY_S=5
